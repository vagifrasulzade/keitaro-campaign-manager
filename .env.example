# --- Keitaro ---------------------------------------------------------------
# Tracker URL without /admin_api/v1
KEITARO_URL=https://tlgk.host
# Profile → API ключи
KEITARO_API_KEY=
# true → in-memory fake tracker, no key needed (demo / local dev)
KEITARO_MOCK=false

# --- Database --------------------------------------------------------------
# Local default is SQLite (file backend/adrobot.db). docker-compose overrides this with Postgres.
# DATABASE_URL=postgresql+asyncpg://adrobot:adrobot@localhost:5432/adrobot

# --- Defaults for "New campaign" (looked up by NAME in Keitaro) ------------
DEFAULT_DOMAIN=kylovoa.com
DEFAULT_GROUP=FORTESTS
DEFAULT_TRAFFIC_SOURCE=FORTESTS
GEO_REDIRECT_URL=https://google.com

# Offer autocomplete cache lifetime (seconds)
OFFERS_CACHE_TTL_SECONDS=600
